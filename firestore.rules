rules_version = '2';

// ---------------------------------------------------------------------
// Security model
// ---------------------------------------------------------------------
// - Every signed-in user has a document at /users/{uid} with:
//     departmentId : which department they belong to
//     role         : "viewer" | "editor" | "admin"
// - A user can only ever read/write data under their own department.
// - "viewer"  -> read-only everywhere.
// - "editor"  -> can read/write the weekly rota, read-only on department
//                settings (theatres/staff/list options).
// - "admin"   -> can also write department settings and manage users.
// ---------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myDept() {
      return me().departmentId;
    }

    function myRole() {
      return me().role;
    }

    function inMyDept(deptId) {
      return signedIn() && myDept() == deptId;
    }

    function isEditorOrAdmin(deptId) {
      return inMyDept(deptId) && (myRole() == 'editor' || myRole() == 'admin');
    }

    function isAdmin(deptId) {
      return inMyDept(deptId) && myRole() == 'admin';
    }

    // Users can read their own profile (needed to bootstrap role/department).
    // Only admins can create/edit user records for their own department.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin(resource.data.departmentId));
      allow write: if signedIn() &&
        ((request.resource.data.departmentId == myDept() && isAdmin(myDept())));
    }

    match /departments/{deptId} {
      allow read: if inMyDept(deptId);
      allow write: if isAdmin(deptId);

      match /theatres/{docId} {
        allow read: if inMyDept(deptId);
        allow write: if isAdmin(deptId);
      }

      match /staff/{docId} {
        allow read: if inMyDept(deptId);
        allow write: if isAdmin(deptId);
      }

      match /weeks/{weekId} {
        allow read: if inMyDept(deptId);
        allow write: if isEditorOrAdmin(deptId);
      }

      match /nursingWeeks/{weekId} {
        allow read: if inMyDept(deptId);
        allow write: if isEditorOrAdmin(deptId);
      }

      match /auditLog/{docId} {
        allow read: if inMyDept(deptId);
        allow write: if isEditorOrAdmin(deptId);
      }

      match /nursingAuditLog/{docId} {
        allow read: if inMyDept(deptId);
        allow write: if isEditorOrAdmin(deptId);
      }

      // Team Board — an informal message board anyone in the department
      // can post to, including "board" kiosk logins on the corridor
      // screen itself, so this is intentionally open to every role, not
      // just editor/admin. Three independent boards, one per page (ODP
      // dashboard, nursing dashboard, corridor board) — see messages.js.
      match /messages/{docId} {
        allow read, write: if inMyDept(deptId);
      }

      match /nursingMessages/{docId} {
        allow read, write: if inMyDept(deptId);
      }

      match /theatreMessages/{docId} {
        allow read, write: if inMyDept(deptId);
      }

      // ---- CADEX (Cadence-Atrium Data Exchange) ------------------------
      // cadexConfig/settings holds the Atrium base URL and both API keys
      // (inbound + outbound) — admin-only in both directions, same as
      // user account management. Cloud Functions read/write all three
      // CADEX collections via the Admin SDK, which bypasses these rules
      // entirely, so "write: if false" below only blocks direct client
      // writes — it doesn't block the sync itself.
      match /cadexConfig/{docId} {
        allow read, write: if isAdmin(deptId);
      }

      // Connection/last-sync status — everyone in the department can see
      // it (same visibility as the rota itself), nobody can write it
      // from the client; it only ever changes via the cadexSync /
      // cadexManualSync Cloud Functions.
      match /cadexStatus/{docId} {
        allow read: if inMyDept(deptId);
        allow write: if false;
      }

      // Imported consultant data, one doc per week — read-only projection
      // the rota page displays alongside the grid; never written by a
      // client, only by the Consumer sync Cloud Function.
      match /cadexImports/{weekId} {
        allow read: if inMyDept(deptId);
        allow write: if false;
      }
    }
  }
}
